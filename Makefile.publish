# Maintainer-only: build & publish drm-display to PyPI.
#
# Deliberately NOT part of the main Makefile.  That one is consumer-facing --
# it compiles libdrm_display.so on the user's machine.  Nothing here concerns
# anyone installing the package.
#
#   make -f Makefile.publish check         - build sdist and sanity-check it
#   make -f Makefile.publish publish-test  - upload to TestPyPI
#   make -f Makefile.publish publish       - upload to PyPI
#   make -f Makefile.publish clean         - remove build artifacts
#   make -f Makefile.publish info          - show package name + version
#
# SDIST ONLY -- no wheel.  drm-display compiles a C library against libdrm at
# build time, so a wheel built here is valid only for this machine's arch.  A
# py3-none-any wheel containing an aarch64 .so is what shipped in 0.1.6: pip
# preferred it over the sdist on every platform and DRMDisplay then failed with
# an unreadable ELF error.  Publishing only the sdist makes pip compile at
# install time, which is the honest behaviour for this package.

# An interpreter that actually has `build` and `twine`: a local venv first,
# then the stack venv, then system python3.  These are dev tools, so where
# they live varies by machine -- `make -f Makefile.publish PY=... ` overrides.
VENVS := .venv/bin/python3 ../.venv/bin/python3
PY ?= $(firstword $(wildcard $(VENVS)) python3)

# "No module named build" is a poor error for a missing tool, so say it plainly.
TOOLS = @$(PY) -c "import build, twine" 2>/dev/null || { \
	  echo "$(PY) has neither build nor twine."; \
	  echo "  python3 -m venv .venv && .venv/bin/pip install build twine"; \
	  echo "  or: make -f Makefile.publish PY=/path/to/a/venv/bin/python $@"; \
	  exit 1; }

.PHONY: build check publish publish-test clean info

build: clean
	$(TOOLS)
	$(PY) -m build --sdist

# twine check covers metadata/README rendering.  The tar check is specific to
# this package: package-data globs *.so, so a stale compiled library can be
# swept into the sdist and shipped as if it were source.
check: build
	$(PY) -m twine check dist/*
	@if tar tzf dist/*.tar.gz | grep -q '\.so$$'; then \
	  echo; echo "REFUSING: a compiled .so is inside the sdist:"; \
	  tar tzf dist/*.tar.gz | grep '\.so$$' | sed 's/^/  /'; \
	  echo "An sdist must carry source only -- the .so is built at install time."; \
	  exit 1; \
	fi
	@echo "sdist contains no compiled objects."

publish-test: check
	$(PY) -m twine upload --repository testpypi dist/*

publish: check
	$(PY) -m twine upload dist/*

clean:
	rm -rf dist build *.egg-info

info:
	@grep -E '^(name|version)' pyproject.toml
